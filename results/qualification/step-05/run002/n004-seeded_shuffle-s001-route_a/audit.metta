te unit0 path_b_002)) (stv 1.0 0.9)) (7)) (Sentence ((Implication (Ready unit0 route_b) (Certificate unit0 path_b_003)) (stv 1.0 0.9)) (9)) (Sentence ((Certificate unit0 path_b_004) (stv 1.0 0.81)) (2 11))) (Sentence ((Ready unit0 route_a) (stv 1.0 0.9)) (1)) 4097 4097)))
