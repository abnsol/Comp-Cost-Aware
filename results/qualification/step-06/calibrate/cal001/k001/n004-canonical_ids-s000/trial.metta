; Mechanically extracted from the pinned native PLN.Derive.
(= (Cost.Expand $Tasks $Beliefs $Selected $taskqueuesize $beliefqueuesize)
   (let (Sentence $x $Ev1) $Selected
     (let $derivations (collapse (superpose ((let* (((Sentence $y $Ev2) (superpose $Beliefs)))
                                             (if (StampDisjoint $Ev1 $Ev2)
                                                 (let $stamp (msort (append $Ev1 $Ev2))
                                                      (superpose ((case (|- $x $y)
                                                                    ((($Txy $TVxy) (Sentence ($Txy $TVxy) $stamp))))
                                                                  (case (|- $y $x)
                                                                    ((($Tyx $TVyx) (Sentence ($Tyx $TVyx) $stamp)))))))
                                                 (empty)))
                                       (case (|- $x) ((($T3 $TV3) (Sentence ($T3 $TV3) $Ev1)))))))
       (let* (($NextTasks (LimitSize (exclude-item (Sentence $x $Ev1) (ConcatUnique $Tasks $derivations)) $taskqueuesize)) ($NextBeliefs (LimitSize (ConcatUnique $Beliefs $derivations) $beliefqueuesize)))
         ($NextTasks $NextBeliefs $derivations)))))

(= (Bench.Clock) (py-call (time.process_time_ns)))
; Recursive calls use the ORIGINAL inputs, never the preceding output queues.
(= (Bench.Batch $k $mode $tasks $beliefs $selected $tq $bq $expected)
   (if (== $k 0) ()
     (let* (($out (if (== $mode Empty) $expected
                       (Cost.Expand $tasks $beliefs $selected $tq $bq)))
            ($rest (Bench.Batch (- $k 1) $mode $tasks $beliefs $selected $tq $bq $expected)))
       (append ($out) $rest))))
(= (Bench.Check $outputs $expected)
   (if (== $outputs ()) True
     (if (== (car-atom $outputs) $expected)
         (Bench.Check (cdr-atom $outputs) $expected) False)))
(= (Bench.One $phase $pair $route $k $mode)
   (let* (($r0 (Bench.Clock))
          ($tasks (Bench.Tasks)) ($beliefs (Bench.Beliefs))
          ($selected (Bench.Candidate $route)) ($expected (Bench.Expected $route))
          ($tq (Bench.TaskLimit)) ($bq (Bench.BeliefLimit))
          ($r1 (Bench.Clock))
          ($outputs (Bench.Batch $k $mode $tasks $beliefs $selected $tq $bq $expected))
          ($end (Bench.Clock))
          ($ok (Bench.Check $outputs $expected)))
     (println! (PAIRED_SAMPLE $phase $pair $route $k (- $r1 $r0) (- $end $r1) $ok))))

(= (Bench.Tasks) ((Sentence ((Ready unit0 route_a) (stv 1.0 0.9)) (1)) (Sentence ((Ready unit0 route_b) (stv 1.0 0.9)) (2)) (Sentence ((Implication (Ready unit0 route_a) (Certificate unit0 path_a)) (stv 1.0 0.9)) (3)) (Sentence ((Implication (Certificate unit0 path_a) (CanOperate unit0)) (stv 1.0 0.9)) (4)) (Sentence ((Implication (Ready unit0 route_b) (Certificate unit0 path_b_001)) (stv 1.0 0.9)) (5)) (Sentence ((Implication (Certificate unit0 path_b_001) (CanOperate unit0)) (stv 1.0 0.9)) (6)) (Sentence ((Implication (Ready unit0 route_b) (Certificate unit0 path_b_002)) (stv 1.0 0.9)) (7)) (Sentence ((Implication (Certificate unit0 path_b_002) (CanOperate unit0)) (stv 1.0 0.9)) (8)) (Sentence ((Implication (Ready unit0 route_b) (Certificate unit0 path_b_003)) (stv 1.0 0.9)) (9)) (Sentence ((Implication (Certificate unit0 path_b_003) (CanOperate unit0)) (stv 1.0 0.9)) (10)) (Sentence ((Implication (Ready unit0 route_b) (Certificate unit0 path_b_004)) (stv 1.0 0.9)) (11)) (Sentence ((Implication (Certificate unit0 path_b_004) (CanOperate unit0)) (stv 1.0 0.9)) (12))))

